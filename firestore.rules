rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Path Variable Hardening (ID Poisoning Guard)
    function isValidId(id) {
      return id is string && id.size() >= 8 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Pillar 2: Validation Blueprint for Seal
    function isValidSeal(data, sealId) {
      return data.keys().hasAll(['id', 'name', 'question', 'hint', 'instructions', 'sealedEnvelope', 'createdAtIso'])
        && data.keys().hasOnly(['id', 'name', 'question', 'hint', 'instructions', 'sealedEnvelope', 'createdAtIso'])
        && data.id is string && data.id == sealId && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.question is string && data.question.size() >= 1 && data.question.size() <= 5000
        && data.hint is string && data.hint.size() >= 0 && data.hint.size() <= 3000
        && data.instructions is string && data.instructions.size() >= 0 && data.instructions.size() <= 3000
        && data.sealedEnvelope is string && data.sealedEnvelope.size() >= 20 && data.sealedEnvelope.size() <= 50000
        && data.createdAtIso is string && data.createdAtIso.size() >= 10 && data.createdAtIso.size() <= 40;
    }

    // Connection test document check
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    // Seals collection:
    // - Single-document get is allowed by exact cryptographic sealId so backend & public links work across devices without login.
    // - List is strictly forbidden to prevent scraping/enumeration of seals.
    // - Create is allowed only when the payload strictly matches the Seal blueprint and does not overwrite an existing seal.
    // - Update and delete are strictly forbidden so no one can modify or delete a seal once created.
    match /seals/{sealId} {
      allow get: if isValidId(sealId);
      allow list: if false;
      allow create: if isValidId(sealId)
        && !exists(/databases/$(database)/documents/seals/$(sealId))
        && isValidSeal(incoming(), sealId);
      allow update: if false;
      allow delete: if false;
    }
  }
}
